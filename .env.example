# Copy to .env and fill in. Never commit .env.
# AI model. Default below is Sarvam-105B (uses SARVAM_API_KEY). Gemini also works: set
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ , GEMINI_API_KEY=..., LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
GEMINI_API_KEY=
DATA_GOV_IN_API_KEY=
SARVAM_API_KEY=

# Optional tuning (defaults shown)
# STORAGE_RH_LIMIT_PCT=70
# RAINY_DAY_MM=2.5
# STALE_AFTER_DAYS=3
# MAX_MANDIS=8
