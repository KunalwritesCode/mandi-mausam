# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Any current Gemini model id from aistudio.google.com works; the alias tracks the latest Flash model.
GEMINI_MODEL=gemini-flash-latest
DATA_GOV_IN_API_KEY=
SARVAM_API_KEY=

# Optional tuning (defaults shown)
# STORAGE_RH_LIMIT_PCT=70
# RAINY_DAY_MM=2.5
# STALE_AFTER_DAYS=3
# MAX_MANDIS=8
